    {
      "parameters": {
        "jsCode": "const proposal = $('Code — Retrouver proposition mémoire').first().json;\nconst projetRow = $input.first()?.json || {};\n\nfunction clean(value) {\n  return String(value ?? '').trim();\n}\n\nconst now = new Date().toLocaleString('fr-FR', { timeZone: 'Europe/Paris' });\n\nconst champsAutorises = [\n  'objectif_actuel',\n  'stade_actuel',\n  'strategie_actuelle',\n  'decisions_cles',\n  'blocages_connus',\n  'prochaines_priorites',\n  'dernier_resume'\n];\n\nconst champ = clean(proposal.champ_a_modifier);\nconst nouvelleValeur = clean(proposal.nouvelle_valeur_proposee);\n\nif (!projetRow.projet) {\n  return [\n    {\n      json: {\n        error: true,\n        error_type: 'project_not_found',\n        message: `Projet introuvable dans Projets_Memoire : ${proposal.projet}`,\n        proposal_id: proposal.proposal_id\n      }\n    }\n  ];\n}\n\nif (!champsAutorises.includes(champ)) {\n  return [\n    {\n      json: {\n        error: true,\n        error_type: 'unauthorized_field',\n        message: `Champ non autorisé : ${champ}`,\n        proposal_id: proposal.proposal_id\n      }\n    }\n  ];\n}\n\nif (!nouvelleValeur) {\n  return [\n    {\n      json: {\n        error: true,\n        error_type: 'empty_value',\n        message: 'La nouvelle valeur proposée est vide.',\n        proposal_id: proposal.proposal_id\n      }\n    }\n  ];\n}\n\nconst updatedRow = {\n  ...projetRow,\n  date_derniere_maj: now\n};\n\nconst ancienneValeur = clean(projetRow[champ]);\n\nif (champ === 'dernier_resume') {\n  updatedRow[champ] = nouvelleValeur;\n} else if (!ancienneValeur) {\n  updatedRow[champ] = nouvelleValeur;\n} else {\n  updatedRow[champ] = `${ancienneValeur}\\n\\n[Mise à jour ${now} — validée par ${proposal.validated_by || 'non précisé'}]\\n${nouvelleValeur}`;\n}\n\nreturn [\n  {\n    json: {\n      ...updatedRow,\n      error: false,\n      _proposal_id: proposal.proposal_id,\n      _validated_by: proposal.validated_by,\n      _decision: proposal.decision,\n      _updated_field: champ,\n      _updated_value: nouvelleValeur,\n      _applique_le: now\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
