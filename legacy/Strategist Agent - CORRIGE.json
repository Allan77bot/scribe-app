      "parameters": {
        "jsCode": "const body = $json.body || $json;\n\nconst now = new Date();\nconst parisDate = now.toLocaleDateString('fr-FR', { timeZone: 'Europe/Paris' });\nconst parisTime = now.toLocaleTimeString('fr-FR', { timeZone: 'Europe/Paris' });\n\nreturn [\n  {\n    json: {\n      id: `scribe_${Date.now()}`,\n      date: parisDate,\n      heure: parisTime,\n      timestamp_iso: body.timestamp_iso || now.toISOString(),\n      auteur: body.author || body.auteur || '',\n      projet: body.project || body.projet || '',\n      type_entree: body.entry_type || '',\n      source: body.source || '',\n      sujet: body.subject || '',\n      note_manuelle: body.note || '',\n      duration_seconds: body.duration_seconds || '',\n      timezone: body.timezone || 'Europe/Paris',\n      app_version: body.app_version || '',\n      secret_token: body.secret_token || '',\n      has_audio: !!$binary?.audio\n    },\n    binary: $binary\n  }\n];"
      },
