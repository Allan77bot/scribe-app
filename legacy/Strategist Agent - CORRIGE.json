    {
      "parameters": {
        "jsCode": "const base = $('Code — Préparer entrée agent').first().json;\n\nlet raw =\n  $json.output ||\n  $json.text ||\n  $json.message?.content ||\n  $json.choices?.[0]?.message?.content ||\n  '';\n\nraw = String(raw)\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(raw);\n} catch (error) {\n  parsed = {\n    resume_ia: raw || 'Analyse IA non parsée.',\n    discussion_du_jour: [],\n    points_evolution: [],\n    decisions: [],\n    actions: [],\n    points_non_clotures: ['La sortie IA n’était pas un JSON valide.'],\n    concordance_idees: '',\n    priorite: 'moyenne',\n    tags: ['parse_error']\n  };\n}\n\nfunction stringify(value) {\n  if (value === undefined || value === null) return '';\n  if (Array.isArray(value) || typeof value === 'object') {\n    return JSON.stringify(value, null, 2);\n  }\n  return String(value);\n}\n\nreturn [\n  {\n    json: {\n      id: base.id,\n      date: base.date,\n      heure: base.heure,\n      timestamp_iso: base.timestamp_iso,\n      auteur: base.auteur,\n      projet: base.projet,\n      type_entree: base.type_entree,\n      source: base.source,\n      sujet: base.sujet,\n      note_manuelle: base.note_manuelle,\n      transcription_brute: base.transcription_brute,\n      resume_ia: parsed.resume_ia || '',\n      discussion_du_jour: stringify(parsed.discussion_du_jour),\n      points_evolution: stringify(parsed.points_evolution),\n      decisions: stringify(parsed.decisions),\n      actions: stringify(parsed.actions),\n      points_non_clotures: stringify(parsed.points_non_clotures),\n      concordance_idees: parsed.concordance_idees || '',\n      priorite: parsed.priorite || 'moyenne',\n      tags: stringify(parsed.tags),\n      statut: 'À traiter',\n      app_version: base.app_version\n    }\n  }\n];"
      },
