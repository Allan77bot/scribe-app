      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nfunction clean(value) {\n  return String(value ?? '').trim();\n}\n\nconst pending = rows\n  .filter(row => {\n    const statut = clean(row.statut).toLowerCase();\n    return statut === 'à valider' || statut === 'a valider';\n  })\n  .filter(row => {\n    return row.id && row.projet && row.champ_a_modifier && row.nouvelle_valeur_proposee;\n  })\n  .map(row => {\n    return {\n      id: clean(row.id),\n      date: clean(row.date),\n      projet: clean(row.projet),\n      champ_a_modifier: clean(row.champ_a_modifier),\n      ancienne_valeur_resume: clean(row.ancienne_valeur_resume),\n      nouvelle_valeur_proposee: clean(row.nouvelle_valeur_proposee),\n      raison: clean(row.raison),\n      niveau_confiance: clean(row.niveau_confiance),\n      validation_humaine_recommandee: clean(row.validation_humaine_recommandee),\n      statut: clean(row.statut),\n      source_recap_date: clean(row.source_recap_date)\n    };\n  });\n\nreturn [\n  {\n    json: {\n      success: true,\n      count: pending.length,\n      items: pending\n    }\n  }\n];"
      },
