# ─────────────────────────────────────────────────────────────
# Scribe IA — variables d'environnement (MODÈLE, commité)
# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est JAMAIS commité (voir .gitignore).
# ─────────────────────────────────────────────────────────────

# Supabase — Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Dashboard → Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY="<cle-anon-public>"

# Dashboard → Settings → API → service_role (SECRET).
# Bypass la RLS. Utilisé UNIQUEMENT côté serveur. Jamais exposé au client.
SUPABASE_SERVICE_ROLE_KEY="<cle-service-role-secrete>"

# URL projet côté serveur (sans NEXT_PUBLIC_). Utilisée par le client admin
# (service_role) dans les server actions et le webhook Stripe.
SUPABASE_URL="https://<project-ref>.supabase.co"

# Dashboard → Settings → Database → Connection string → URI (mode direct, port 5432).
# Sert à appliquer les migrations SQL. Contient le mot de passe DB → secret.
SUPABASE_DB_URL="postgresql://postgres:<mot-de-passe-db>@db.<project-ref>.supabase.co:5432/postgres"

# Le <project-ref> ci-dessus (sous-domaine de l'URL). Pour la CLI Supabase si besoin.
SUPABASE_PROJECT_REF="<project-ref>"

# ─────────────────────────────────────────────────────────────
# Provisioning automatique (npm run setup:supabase) — facultatif.
# Personal Access Token : https://supabase.com/dashboard/account/tokens
# PUISSANT (gère tous tes projets). Révocable après usage. Jamais commité.
# ─────────────────────────────────────────────────────────────
SUPABASE_ACCESS_TOKEN="<personal-access-token>"
# Optionnel : forcer l'organisation et la région.
# SUPABASE_ORG_ID="<org-id>"
# SUPABASE_REGION="eu-central-1"
# SUPABASE_PROJECT_NAME="scribe"

# ─────────────────────────────────────────────────────────────
# Stripe — facturation (Phase 5). Mode TEST tant qu'on n'est pas en prod.
# Dashboard Stripe → Developers → API keys.
# ─────────────────────────────────────────────────────────────
# Clé secrète serveur (sk_test_… en test). JAMAIS côté client.
STRIPE_SECRET_KEY="sk_test_<cle-secrete-stripe>"

# Secret de signature du webhook (whsec_…). Stripe CLI ou Dashboard → Webhooks.
# Endpoint à déclarer : POST /api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_<secret-webhook>"

# IDs de prix Stripe (un par plan). Dashboard → Products → Prix → API ID.
STRIPE_PRICE_SOLO="price_<id-prix-solo>"
STRIPE_PRICE_TEAM="price_<id-prix-team>"
STRIPE_PRICE_BUSINESS="price_<id-prix-business>"

# Clé publishable (pk_test_…) — affichage front uniquement, aucune opération.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_<cle-publishable>"

# URL publique du site (success_url / cancel_url Stripe Checkout).
# En dev, http://localhost:3000 par défaut si absent.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
